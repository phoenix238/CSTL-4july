generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One record per client — the app's index. The client's Drive folder + Google Doc
// (pointed at by driveFolderId / docId) remain the system of record for notes.
model Client {
  id            String        @id @default(cuid())
  name          String
  email         String        @default("")
  phone         String        @default("")
  clinic        String        @default("waterloo") // preferred clinic: waterloo | bethnal
  marketing     Boolean       @default(false)
  intakeDone    Boolean       @default(false)
  welcomeSent   Boolean       @default(false) // access note + intake link go in the FIRST email only
  dob           String        @default("")
  occupation    String        @default("")
  doctor        String        @default("")
  meds          String        @default("")
  conditions    String        @default("")
  emergency     String        @default("")
  referred      String        @default("")
  driveFolderId String        @default("")
  docId         String        @default("")
  intakeToken   String        @default("") // private token for the client's in-app intake link
  intakeEmailSentAt DateTime? // last time the intake-form email was sent
  reviewEmailSentAt DateTime? // last time the post-session review email was sent
  consentGiven  Boolean? // null = not yet answered; set from the intake form's Yes/No consent question
  // Present in the shared production DB from the intake-auto-share feature on
  // another branch (client-message-intake-workflow) — not wired into any code
  // here. Declared so `prisma db push` never proposes dropping this real data.
  calendarInviteSharedAt DateTime?
  // Client portal (/me/[token]) — a permanent private link the client bookmarks,
  // where they book their next session, reschedule, and see what they owe.
  // Deliberately a token rather than a password login: nothing to forget, nothing
  // to reset, and the portal stays undiscoverable while the practice is private.
  portalToken   String        @default("")
  // The reference the client puts on their bank transfer. Derived from their name
  // so it's memorable ("JONO-4K2"), with a short random suffix so two Jonos never
  // collide. Assigned once and never changed — it's printed on past emails.
  paymentRef    String        @default("")
  // Set when a client asks for a receipt before anything's confirmed paid yet —
  // the next booking that gets marked paid sends it automatically, then clears this.
  receiptPending Boolean      @default(false)
  // Which app-sent session reminders the client wants, as lead times in days
  // before each session: 7 = a week before, 1 = the day before, 0 = the morning
  // of. Set by the client from their own portal (/me/[token]). These are emails
  // the app sends itself (from the daily cron), independent of whether the client
  // uses Google Calendar — the safety net for someone who never added the invite
  // to a calendar of their own. Defaults to empty (off) — nobody gets a reminder
  // email until they visit their portal and switch one on themselves; an existing
  // client is never silently opted in by this column's default.
  reminderLeadDays Int[]      @default([])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  bookings      Booking[]
  notes         SessionNote[]
  recordings    SessionRecording[]
  enquiries     Enquiry[]

  @@index([name])
  @@index([email])
  @@index([intakeToken])
  @@index([portalToken])
  @@index([paymentRef])
}

// Cached copy of a session note for instant profile views;
// the authoritative copy is appended to the client's Google Doc on save.
model SessionNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date      DateTime
  clinic    String
  raw       String
  bullets   String[]
  // Present in the shared production database from the case-history/reflections
  // feature on another branch (claude/case-history-layout-8h40fq) — not wired
  // into any code here, and holding 12 real, non-null session notes' worth of
  // data as of Aug 2026. Declared so `prisma db push` never proposes dropping
  // it. See calendarInviteSharedAt above for the same situation on Client.
  between     String @default("") // how they'd been since the last session
  reflections String @default("") // Phoenix's reflections on this session
  nextSession String @default("") // thoughts to pick up next time
  createdAt DateTime @default(now())

  @@index([clientId, date])
}

// A live Clean Language session captured in the Session tab. The full verbatim
// transcript lives here (the app is where you glance back at exact words); a
// curated summary + pinned phrases + notes are also appended to the client's Doc.
model SessionRecording {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date       DateTime
  clinic     String
  transcript String   // full live transcript, verbatim
  pinned     String[] // the client's highlight moments (their words)
  myNotes    String   @default("") // therapist's own notes taken during the session
  bullets    String[] // Claude-generated summary bullets
  createdAt  DateTime @default(now())

  @@index([clientId, date])
}

model Booking {
  id               String   @id @default(cuid())
  clientId         String
  // Restrict, not Cascade: a client's booking history is the record of what
  // actually happened and must survive a client-record deletion. Postgres
  // itself refuses to delete a Client while it still has any Booking rows —
  // deleteClient() in clients.ts checks this up front for a clear error
  // instead of a raw FK-violation.
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  startsAt         DateTime // start of the 60-min session
  clinic           String // waterloo | bethnal
  status           String   @default("confirmed") // confirmed | cancelled | done
  personalEventId  String   @default("") // "(Client) — Clinic" on the personal calendar
  secondaryEventId String   @default("") // Waterloo: "R5 - Phoenix" room event · Bethnal: the day's shared auto-sized "Phoenix" Chalk Farm block
  // Present in the shared production DB from the WTR-5 fallback-room feature
  // (still open, not merged) — not wired into any code here. Declared so
  // `prisma db push` never proposes dropping this real data.
  roomUsed         String   @default("")
  emailSent        Boolean  @default(false)
  // Set when the booking succeeded but its confirmation email didn't go out, so
  // a client left with nothing in writing is findable and can be followed up —
  // rather than the failure existing only in a server log.
  confirmationFailedAt DateTime?
  createdAt        DateTime @default(now())

  // — Payment —
  // What this session costs, in pence. Waterloo is a fixed £80; Bethnal Green is a
  // £30–60 sliding scale, so it stays null until the actual amount is known (set
  // from the client profile after the session, or when they tell you what they paid).
  amountPence   Int?
  paid          Boolean   @default(false)
  paidAt        DateTime?
  // Free-text note on the payment — "cash on the day", "bank transfer 12 Aug", etc.
  paymentNote   String    @default("")
  // Set when Phoenix has been told this session is still unpaid a day after it
  // happened, so the hourly sweep flags each one once rather than every hour.
  unpaidNotifiedAt DateTime?
  // Set when a payment-reminder email has been sent to the client for this
  // session — so they're gently chased at most once.
  paymentReminderSentAt DateTime?
  // Set when Phoenix has been alerted that this session's calendar event is
  // missing or has been moved out from under the booking; cleared when the event
  // lines up again, so the reconcile alert fires once per problem.
  calendarAlertAt DateTime?

  // — Cancellation / no-show —
  cancelledAt   DateTime?
  // "client" when they cancelled it themselves from the portal, "admin" when Phoenix did.
  cancelledBy   String    @default("")
  // Suggested goodwill contribution when a session is cancelled at short notice or
  // missed. Deliberately NOT a charge and never counted as debt — this is a sliding
  // scale practice, and the ask is an invitation, not an invoice. It's recorded only
  // so it isn't forgotten by either side.
  goodwillPence Int       @default(0)
  goodwillReason String   @default("") // "late_cancel" | "no_show"
  // Settled = they contributed. Waived = Phoenix decided not to ask at all.
  goodwillSettled Boolean @default(false)
  goodwillWaived  Boolean @default(false)

  // How the booking was made, so the inbox and stats can tell them apart.
  bookedVia       String @default("admin") // admin | online | portal | offer
  rescheduleCount Int    @default(0)
  // Which of the client's chosen reminder lead times (see Client.reminderLeadDays)
  // have already been emailed for this session, so the daily sweep sends each one
  // once and never repeats. Cleared on reschedule — a moved session earns its
  // reminders afresh against the new date.
  remindersSentLead Int[] @default([])

  @@index([startsAt])
  @@index([clientId])
}

model Enquiry {
  id        String   @id @default(cuid())
  via       String   @default("PASTED") // WHATSAPP | EMAIL | PASTED
  name      String   @default("")
  text      String
  status       String     @default("waiting") // waiting | offered | booked | booked_online | dismissed
  clientId     String? // set once the enquiry is saved as / matched to a client
  client       Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clinic       String     @default("") // which clinic the offered times are for
  offeredTimes DateTime[] // slots offered to the client (offer mode), awaiting their pick
  offerToken   String     @default("") // private token for the client's self-book link
  createdAt    DateTime   @default(now())
  // Set when the enquiry came in via the Gmail add-on — so booking/offer replies
  // land back in the client's original Gmail thread instead of a fresh email.
  gmailThreadId  String   @default("") // Gmail thread id of the client's email
  gmailMessageId String   @default("") // RFC Message-ID, for In-Reply-To/References

  @@index([clientId])
  @@index([offerToken])
}

/**
 * One row per attempt to book from the public page — what the rate limit counts.
 *
 * The booking form is open to the internet by design, and every accepted
 * submission creates a client record, a Drive folder, a Doc, two calendar
 * events and an email sent from Phoenix's own Gmail. Without a ceiling, a
 * script can fill the diary, fill Drive, and get the sending account throttled.
 * Kept in Postgres rather than in memory because serverless instances don't
 * share memory — an in-process counter would reset constantly and count wrong.
 */
model BookingAttempt {
  id        String   @id @default(cuid())
  /** "email:someone@example.com" or "ip:1.2.3.4" */
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Single row (id = 1). Holds editable settings and the Google wiring.
model AppSettings {
  id                    Int    @id @default(1)
  // Which Claude model powers the enquiry reader, note/session summaries and
  // client-file import ("sonnet" | "haiku") — see lib/claude.ts. Sonnet is the
  // more careful reader (worth it for case-history judgment calls); Haiku is
  // faster/cheaper. Anything else falls back to sonnet.
  aiModel               String @default("sonnet")
  accessNote            String @default("My treatment space has no step-free access at both locations — there are stairs. Please let me know if mobility or accessibility is a concern and I will do my best to accommodate your needs.")
  // The one welcome letter, shared by both clinics. What differs between them —
  // price, address, map pin, how to find the door — is filled in around it, so
  // the wording only has to be written and edited once.
  // Placeholders: {name} {when} {clinic} {price} {accessNote} {intakeLink}
  // Voice only — the composer places the address, map, payment, booking page,
  // intake link and sign-off around it, so the letter carries no facts and no
  // sign-off of its own (emailSignOff below is appended once, at the very end).
  emailTemplate         String @default("Hi {name},\n\nYou're booked in for {when} at {clinic} — 60 minutes, {price}.\n\n{accessNote}")
  // The confirmation a *returning* client gets — the short one, for someone who
  // already has their booking page, knows how to pay, and filled the form in
  // long ago. Used to be hardcoded in the composer, which meant the one email
  // Phoenix sends most often was the only one he couldn't change a word of.
  // Placeholders: {name} {when} {clinic} {price}
  // Voice only, same as emailTemplate — the address, map pin, how-to-find and
  // sign-off are placed around it.
  emailTemplateReturning String @default("Hi {name},\n\nJust confirming your next session: {when} at {clinic}.")
  // The one sign-off every email ends on. Appended by the composer after any
  // sign-off in the letter is stripped, so a template that still ends "See you
  // soon, Phoenix" can't produce a second ending.
  emailSignOff          String @default("with gratitude\nPhoenix")
  // Legacy per-clinic letters, superseded by emailTemplate above. Kept (rather
  // than dropped) so `prisma db push` never touches existing wording, and used
  // as the fallback for whichever clinic until emailTemplate is saved.
  emailTemplateWaterloo String @default("Hi {name},\n\nYou're booked in for {when} at Waterloo — 60 minutes, £80, payable on the day by card or bank transfer.\n\n{accessNote}\n\nSee you soon,\nPhoenix")
  emailTemplateBethnal  String @default("Hi {name},\n\nYou're booked in for {when} at Bethnal Green — 60 minutes on a £30–60 sliding scale, pay what feels fair on the day.\n\n{accessNote}\n\nSee you soon,\nPhoenix")
  paymentDetails        String @default("You can pay on the day by card, or by bank transfer using the details below.")
  waterlooAddress       String @default("") // full address — calendar invite location + Maps link in the first email
  bethnalAddress        String @default("") // full address — calendar invite location + Maps link in the first email
  // A short line the venues can reach Phoenix on — added to the description of the
  // room ("R5 - Phoenix") and Chalk Farm ("Phoenix") calendar events, alongside the
  // day's session count and times. Client names stay off the shared venue calendars.
  clinicContactLine     String @default("")
  // How to find and get into each place — buzzer, floor, parking, which door.
  // One field per clinic, shown on the public booking page *and* in the
  // confirmation email; replaces the old arrival-note/directions pair, which
  // said much the same thing in two places and reached different surfaces.
  waterlooFindIt        String @default("")
  bethnalFindIt         String @default("")
  // An optional photo of the entrance per clinic — the green door, the buzzer,
  // the alley you'd otherwise walk past. Stored as a data: URL (the Settings
  // upload downscales before saving), shown on the public booking page and sent
  // inline with the confirmation email, so it travels with the message rather
  // than depending on a link the client has to be given access to.
  waterlooPhoto         String @default("")
  bethnalPhoto          String @default("")
  // Legacy — folded into waterlooFindIt / bethnalFindIt above, kept for the data.
  waterlooArrivalNote   String @default("")
  bethnalArrivalNote    String @default("")
  // Shareable "where we are" details you copy from a client's profile (or Settings)
  // to paste into WhatsApp/email — a map/pin link plus any extra directions, per clinic.
  waterlooLocationUrl   String @default("")
  bethnalLocationUrl    String @default("")
  waterlooDirections    String @default("")
  bethnalDirections     String @default("")
  intakeFormUrl         String @default("https://forms.gle/2nPTLzHcffgzmydo8")
  googleRefreshToken    String @default("")
  // What Google actually granted, and how the connection is actually behaving.
  // "Connected" used to mean nothing more than "a refresh token string exists",
  // so the app showed a green tick while every send failed. These three record
  // the truth instead: the scopes consent really returned, when the token was
  // last stored, and the last real error Google gave us (cleared on a success).
  googleScopes          String @default("") // space-separated, straight from the OAuth response
  googleConnectedAt     DateTime?
  googleLastError       String @default("") // "" = last Google call worked
  googleLastCheckedAt   DateTime?
  personalCalendarId    String @default("primary")
  roomCalendarId        String @default("") // R5 room calendar
  // Present in the shared production DB from the WTR-5 fallback-room feature
  // (still open, not merged) — not wired into any code here. Declared so
  // `prisma db push` never proposes dropping this real data.
  roomFallbackCalendarId String @default("")
  roomFallbackLabel      String @default("R6")
  chalkFarmCalendarId   String @default("") // Bethnal Green shared day blocks
  // — Phoenix's own calendar reminders (his copy of each session event only;
  //   an attendee's reminders are always their own, never set from here) —
  // How he wants reminding of his own sessions:
  //   "morning"     — one popup on the morning of the session (see ownReminderMorningHour)
  //   "before"      — one popup ownReminderMinutesBefore minutes before it
  //   "email_popup" — the old pair: an email 24h before and a popup 1h before
  //   "none"        — nothing on the session event (he relies on the app's Today view)
  ownReminderMode        String @default("morning")
  ownReminderMinutesBefore Int  @default(60) // used when ownReminderMode = "before"
  ownReminderMorningHour Int    @default(8)  // London hour the morning-of popup fires (used when mode = "morning")
  // Whether the venue-facing events (the "R5 - Phoenix" room event and the shared
  // "Phoenix" Chalk Farm block) also carry his reminders. Off by default so he
  // isn't reminded twice for one session — once by the personal event, once by
  // the room/block. Turn on only if he wants the venue events to nag too.
  venueReminders         Boolean @default(false)
  // — Availability ⇄ Google Calendar two-way sync —
  // A dedicated "CSTL Availability" calendar that mirrors the bookable hours
  // (recurring weekly hours + one-off overrides) as concrete dated blocks,
  // editable from either side. Empty until connected in Settings › Availability.
  availabilityCalendarId        String @default("")
  // Google's incremental sync cursor for that calendar's events, so a pull only
  // fetches what changed since last time. Cleared (forcing a full resync) if
  // Google rejects it as stale (410).
  availabilityCalendarSyncToken String @default("")
  availabilityLastSyncAt        DateTime?
  // Clinic assumed for a block drawn directly in Google whose title carries no
  // clinic keyword (waterloo / bethnal | bg) — the one shared calendar can't tell
  // the two apart on its own.
  availabilityDefaultClinic     String @default("waterloo")
  clientsFolderId       String @default("") // Drive › CSTL › Clients
  reflectionsDocId      String @default("") // Drive › CSTL › "Phoenix session reflections" — one Doc, all clients
  marketingSheetId      String @default("") // spreadsheet at Drive › CSTL › Clients › Docs
  appUrl                String @default("") // base URL for building intake / share links
  intakeQuestions       Json? // configurable intake questions; null = built-in defaults
  clientCopy            Json? // editable client-facing message overrides; null/missing keys = built-in defaults (see lib/clientCopy.ts)
  // The review email, written once. Only the review LINK differs per clinic
  // (below) — each clinic is its own Google Business listing — so the wording
  // lives here and both clinics share it. The per-clinic subject/body pair below
  // is the legacy split; it stays as the fallback until this pair is saved.
  mapsReviewUrl         String @default("") // legacy single review link, superseded by the per-clinic pair below
  reviewEmailSubject    String @default("How was your session?")
  reviewEmailBody       String @default("Hi {name},\n\nIt was lovely to see you. I really hope your session landed well.\n\nIf you have a moment, a short Google review means the world to a small practice like mine:\n{mapsUrl}\n\nAnd if you'd like the occasional email about offers and clinic news, you can opt in here (one tap, no obligation):\n{optInLink}\n\nwith gratitude\nPhoenix")
  // The review link per clinic — these two stay split, because Waterloo and
  // Bethnal Green are separate Google Business listings with separate reviews.
  mapsReviewUrlWaterloo    String @default("") // Google Maps "leave a review" link — Waterloo
  mapsReviewUrlBethnal     String @default("") // Google Maps "leave a review" link — Bethnal Green
  // Legacy per-clinic wording, superseded by the shared reviewEmailSubject /
  // reviewEmailBody above. Kept for the data, and used as the fallback for
  // whichever clinic until the shared pair is saved.
  reviewEmailSubjectWaterloo String @default("How was your session?")
  reviewEmailSubjectBethnal  String @default("How was your session?")
  reviewEmailBodyWaterloo  String @default("Hi {name},\n\nIt was lovely to see you. I really hope your session landed well.\n\nIf you have a moment, a short Google review means the world to a small practice like mine:\n{mapsUrl}\n\nAnd if you'd like the occasional email about offers and clinic news, you can opt in here (one tap, no obligation):\n{optInLink}\n\nwith gratitude\nPhoenix")
  reviewEmailBodyBethnal   String @default("Hi {name},\n\nIt was lovely to see you. I really hope your session landed well.\n\nIf you have a moment, a short Google review means the world to a small practice like mine:\n{mapsUrl}\n\nAnd if you'd like the occasional email about offers and clinic news, you can opt in here (one tap, no obligation):\n{optInLink}\n\nwith gratitude\nPhoenix")

  // Public self-booking (/book) — recurring weekly hours per clinic; null/empty = nothing
  // bookable yet, until configured in Settings › Availability. Shape: WeeklyHours in
  // src/lib/booking/availability.ts.
  weeklyHours          Json?
  // Tunable booking parameters — the Settings "switchboard" sliders.
  bookingSlotMinutes   Int @default(30)  // candidate slot spacing
  bookingMinNoticeMins Int @default(120) // can't book within this many minutes of now
  bookingHorizonDays   Int @default(21)  // how many days ahead the public page shows/allows
  bookingBufferMinutes Int @default(0)   // Waterloo: minimum gap between Phoenix's own back-to-back sessions there
  bethnalBufferMinutes Int @default(15)  // Bethnal Green: minimum gap between Phoenix's own back-to-back sessions there — separate from Waterloo since they don't need the same spacing
  chalkFarmBufferMinutes Int @default(30) // safety gap around a studio-mate's booking on the shared Chalk Farm calendar (Bethnal Green)
  chalkFarmEdgeBufferMinutes Int @default(15) // padding added before the day's first and after the day's last Bethnal session on the shared "Phoenix" Chalk Farm block, so studio-mates don't book right up against it
  // Unwired here — declared only to match production, which already has this column from
  // #23 (Chalk Farm clustering, still open). Prevents `prisma db push` from proposing to
  // drop real data on every deploy until #23 merges its actual (wired) definition.
  chalkFarmClusterGapMinutes Int @default(45)
  chalkFarmWeeklyCapHours Int @default(10) // Bethnal Green: max total hours of Phoenix's own confirmed sessions bookable in one London calendar week (Mon-Sun); 0 = no cap
  // Travel time between the two clinics. Working a Waterloo morning and a Bethnal
  // Green evening on the same day is fine and deliberate — this is the clearance
  // kept around a session at the *other* site so the two can't be booked so close
  // together that the journey is impossible.
  crossClinicGapMinutes Int @default(90)
  bookingNotifyEmail   Boolean @default(true) // email Phoenix when someone books via /book

  // — Client portal (/me/[token]) —
  portalEnabled      Boolean @default(true) // master switch for the client portal
  portalNotifyEmail  Boolean @default(true) // email Phoenix on every portal book/reschedule/cancel
  // How much notice a client needs to move a session themselves.
  portalNoticeHours  Int     @default(24)
  // Suggested goodwill contribution when a session is cancelled inside that window.
  // An invitation, not a charge — set to 0 to stop mentioning it at all.
  lateCancelGoodwillPence Int @default(1000)
  // Can clients ask for a receipt from their page?
  portalReceipts     Boolean @default(true)
  // Can clients book their next session themselves from the portal? Separate from
  // the fully-public /book page, which stays unlisted while the practice is private.
  portalSelfBook     Boolean @default(true)

  // — Bank transfer details, shown on the portal with the client's own reference —
  bankAccountName   String @default("")
  bankSortCode      String @default("")
  bankAccountNumber String @default("")
  // Anything extra to show under the bank details on the portal.
  bankPaymentNote   String @default("")

  // Last time Phoenix opened Home and its notifications were marked seen — an
  // online booking newer than this still shows a red dot on the Home nav link.
  notificationsViewedAt DateTime? @default(now())

  // — Starling payment matching —
  // Off until switched on, so nothing touches payment state unexpectedly.
  starlingEnabled    Boolean   @default(false)
  // Mark the session paid automatically on a confident match. Off means payments
  // are still collected and matched, but wait for a tap to be applied.
  starlingAutoMark   Boolean   @default(true)
  starlingNotifyEmail Boolean  @default(true)
  // How far back to look on the first sync, and the watermark thereafter.
  starlingLookbackDays Int     @default(30)
  starlingLastSyncAt DateTime?
}

// One incoming bank payment seen on the Starling feed.
//
// Every payment is recorded here whether or not it matched a client, so the
// unmatched ones are visible and fixable rather than silently dropped. The
// feedItemUid is Starling's own id and is unique, which is what makes the sync
// safe to re-run: a payment already seen is skipped, never applied twice.
model BankTransaction {
  id           String   @id @default(cuid())
  feedItemUid  String   @unique
  transactedAt DateTime
  amountPence  Int
  reference    String   @default("") // as the payer typed it
  counterParty String   @default("") // sender's name — for eyeballing, never for matching
  // matched | unmatched | ambiguous | ignored
  status       String   @default("unmatched")
  clientId     String?
  bookingId    String? // the session this settled, when one was chosen
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([transactedAt])
}

// Single row (id = 1). Hands out the sequential half of a client's bank-transfer
// reference ("JS-4"). A counter rather than a max()+1 scan so two clients created
// at the same moment can never be handed the same number — the increment below is
// atomic in Postgres, and the number is what makes the reference unique.
model PaymentRefCounter {
  id   Int @id @default(1)
  next Int @default(1)
}

// The single shared "Phoenix" room block on the Chalk Farm calendar for one day.
// Bethnal Green sessions nest inside it; the block auto-grows/shrinks to span the
// day's sessions, so clients can sit as close as the schedule allows (not 2h apart).
model ChalkFarmDayBlock {
  date      String   @id // "YYYY-MM-DD" London calendar date
  eventId   String   @default("") // the Google event id of that day's shared block
  // Unwired here — declared only to match production, which already has this column from
  // #23 (Chalk Farm clustering, still open). Prevents `prisma db push` from proposing to
  // drop real data on every deploy until #23 merges its actual (wired) definition.
  eventIds  String[] @default([])
  updatedAt DateTime @updatedAt
}

// The projection mirror for the availability ⇄ Google Calendar sync: one row per
// Google event the app has written onto the "CSTL Availability" calendar,
// recording the open window that event represents. It makes the app→Google diff
// idempotent (compare the expected windows against these rows, insert/patch/
// delete the difference) and lets a changed or deleted Google event be folded
// back into the right one-off override — the block it used to be is known here.
model AvailabilityEvent {
  eventId    String   @id // the Google Calendar event id
  clinic     String // waterloo | bethnal
  dateKey    String // "YYYY-MM-DD" London day the block sits on
  startMin   Int // minutes after London midnight
  endMin     Int
  // "weekly" = derived from the recurring weekly hours; "override" = derived
  // from an AvailabilityOverride open window. A delete/move in Google is folded
  // back differently for each (see src/lib/google/availabilitySync.ts).
  source     String
  overrideId String   @default("") // set when source = "override"
  updatedAt  DateTime @updatedAt

  @@index([dateKey])
  @@index([overrideId])
}

// One-off availability exceptions — either opens an extra date/window beyond the
// recurring weekly hours, or blocks/closes a normally-open one (holidays etc.).
model AvailabilityOverride {
  id        String   @id @default(cuid())
  clinic    String   // waterloo | bethnal
  /**
   * "YYYY-MM-DD", London calendar date — plain string avoids DST/UTC edge cases.
   * For a repeating window this is the date it was drawn on: the first day it
   * applies, and the weekday it recurs on.
   */
  date      String
  kind      String   // "open" | "block"
  startMin  Int      // minutes after London midnight
  endMin    Int      // minutes after London midnight
  /**
   * Applies to this weekday every week from `date` onward, until removed —
   * so availability drawn on the calendar can be the primary way hours are set,
   * rather than something re-drawn every week.
   */
  repeatWeekly Boolean @default(false)
  /**
   * For an "open" window: offer only its start time as a single pickable slot,
   * rather than stepping a grid of starts across it. Lets a day be built from
   * specific times ("7:00 and 8:15") instead of an open block the booking grid
   * fills in. Ignored for a "block".
   */
  exactStart Boolean @default(false)
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([clinic, date])
  // Repeating windows are fetched for the whole clinic regardless of date.
  @@index([clinic, repeatWeekly])
}
